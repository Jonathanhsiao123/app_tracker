# jobmon settings for runs on your own machine.
#
# Copy this file to `.env` (gitignored) and fill in what you use; `jobmon` reads it on start.
# Blank values are ignored, and anything already set in your shell wins over this file.
#
# On GitHub Actions these come from repository settings instead - this file is never
# uploaded. Settings > Secrets and variables > Actions:
#   "Secrets" tab   -> every name below marked [secret]
#   "Variables" tab -> every name below marked [variable]

# --- push notifications (required for a real run) ------------------------------------
# [secret] Any hard-to-guess string; subscribe to the same topic in the ntfy app.
JOBMON_NTFY_TOPIC=

# --- email digest (optional; leave all blank for ntfy only) ---------------------------
# [secret] e.g. smtp.gmail.com
JOBMON_SMTP_HOST=
# [secret] 587 (STARTTLS) or 465 (implicit TLS)
JOBMON_SMTP_PORT=
# [secret]
JOBMON_SMTP_USER=
# [secret] For Gmail, an App Password, not your account password.
JOBMON_SMTP_PASSWORD=
# [secret] The sender address.
JOBMON_EMAIL_FROM=
# [secret] Where the digest goes.
JOBMON_EMAIL_TO=

# --- LLM clearance screen on Luminal (profile `screening.enabled`) --------------------
# [secret] Your Luminal API key.
LUMINAL_API_KEY=
# [secret] Endpoint base URL, up to but NOT including /chat/completions,
# e.g. https://<your-endpoint>/v1
LUMINAL_BASE_URL=
# [variable] The model name of your Luminal deployment. Alternatively put it in
# `screening.model` in jobmon/config/profiles/jonathan.yaml.
LUMINAL_MODEL=
# [variable] Set to `off` to skip the screen without editing the profile.
JOBMON_LLM_SCREEN=
